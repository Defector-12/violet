{
  "name": "@violet/root",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22.16.0 <25",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "acceptance:report": "node scripts/report-realtime-acceptance.mjs",
    "test:report": "node scripts/test-run.mjs report",
    "test:record": "node scripts/test-run.mjs command --",
    "build": "pnpm -r build",
    "check": "pnpm generate && biome check . && pnpm typecheck && pnpm test",
    "check:ci": "pnpm check && git diff --exit-code -- packages/protocol/src/generated",
    "clean": "pnpm -r clean",
    "env:init": "node scripts/init-local-env.mjs",
    "env:inject-devbox": "node scripts/inject-devbox-secrets.mjs",
    "env:inject-devbox-qwen": "node scripts/inject-devbox-secrets.mjs --qwen-only",
    "eval:phase1-checkpoints": "pnpm --filter @violet/core build && node scripts/eval-phase1-checkpoints.mjs",
    "format": "biome check --write .",
    "generate": "pnpm --filter @violet/protocol generate",
    "macos:app": "./scripts/build-macos-app.sh debug",
    "macos:configure": "node scripts/configure-macos-client.mjs",
    "macos:migrate-token": "./scripts/migrate-device-token-to-keychain.sh",
    "macos:test": "node scripts/test-run.mjs command -- bash scripts/test-macos.sh",
    "macos:wake-assets": "./scripts/fetch-wake-word-assets.sh",
    "test": "node scripts/test-run.mjs command -- pnpm exec vitest run",
    "typecheck": "pnpm -r build && pnpm -r typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "@types/node": "24.10.1",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
