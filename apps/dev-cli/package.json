{
  "name": "@violet/dev-cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "violet": "./dist/main.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "dev": "tsx src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@violet/protocol": "workspace:*",
    "@violet/sdk": "workspace:*"
  },
  "devDependencies": {
    "tsx": "4.21.0"
  }
}
