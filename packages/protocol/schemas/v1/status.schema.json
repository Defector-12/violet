{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://violet.local/schemas/v1/status.schema.json",
  "title": "CoreStatus",
  "type": "object",
  "additionalProperties": false,
  "required": ["service", "state", "time", "version"],
  "properties": {
    "service": {
      "const": "violet-core"
    },
    "state": {
      "type": "string",
      "enum": ["sealed", "ready"]
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "time": {
      "type": "string",
      "format": "date-time"
    },
    "version": {
      "type": "string",
      "minLength": 1
    }
  }
}
