{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://violet.local/schemas/v1/error.schema.json",
  "title": "ApiError",
  "type": "object",
  "additionalProperties": false,
  "required": ["code", "message", "requestId", "retryable"],
  "properties": {
    "code": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]+$"
    },
    "message": {
      "type": "string",
      "minLength": 1
    },
    "requestId": {
      "type": "string",
      "format": "uuid"
    },
    "retryable": {
      "type": "boolean"
    }
  }
}
